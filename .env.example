# Copy this file to .env and fill in your values. NEVER commit .env.

# --- Core ---
# Required when APP_ENV=production. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=
APP_ENV=development
# Set to 1 only when serving over HTTPS
SESSION_COOKIE_SECURE=0

# --- AI Copilot (any OpenAI-compatible chat API with tool calling) ---
# Leave AI_API_KEY empty to run without AI (dashboard, planner and quick data still work).
AI_API_KEY=""
AI_BASE_URL=https://api.groq.com/openai/v1
AI_MODEL=openai/gpt-oss-120b
AI_TIMEOUT_SECONDS=30
AI_MAX_STEPS=5

# --- Weather (Open-Meteo, no key needed) ---
# Town or city used for forecasts, e.g. Madurai. Leave empty to turn weather off.
FARM_LOCATION=

# --- Optional ---
# DATABASE_URL=sqlite:///database/farm.db
# FLASK_DEBUG=1
